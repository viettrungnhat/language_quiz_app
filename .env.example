# ========================================
# CẤU HÌNH API KEYS
# ========================================
# Nhân bản file này thành .env và điền thông tin
# Hoặc sử dụng nút "⚙️ Cài đặt API" trong app để cấu hình trực tiếp

# AWS Polly Configuration (Text-to-Speech cho Anh/Trung/Nhật)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=ap-southeast-2

# Discord Webhook Configuration (Gửi kết quả thi lên Discord)
# Cách lấy: Server Settings > Integrations > Webhooks > New Webhook
# Format: https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ⚠️ QUAN TRỌNG: Không commit file .env lên GitHub!
# File .env đã được thêm vào .gitignore để bảo mật
